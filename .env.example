# 私有配置：复制到 .env.local，切勿提交真实密钥。
FINANCE_PORT=3099
LLM_PROVIDER=zhipu
LLM_MODEL=glm-5.3-flash
# 本机已授权配置在.env.local；新配置需显式启用真实材料处理。
LLM_REAL_CONTENT_ENABLED=0
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
# deepseek 使用 LLM_PROVIDER=deepseek 与 LLM_MODEL=deepseek-flash
# 本产品模型调用的每日预算、请求数上限；默认1元/200次。
LLM_DAILY_BUDGET_CNY=1
LLM_DAILY_REQUEST_LIMIT=200
